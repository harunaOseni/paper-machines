# Development: copy to .env and supply your server-side API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional development port override: PORT=4173

# Railway environment: npm start, health check /api/health.
# NODE_ENV=production
# HOST=0.0.0.0
# ALLOWED_ORIGINS=https://your-site.netlify.app,https://your-domain.example
# Railway supplies PORT automatically.

# Netlify build environment: exact Railway origin, no path.
# PUBLIC_API_ORIGIN=https://your-service.up.railway.app
# Never put OPENAI_API_KEY in Netlify frontend configuration.
