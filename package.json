{
  "name": "paper-machines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bring your drawings to life as animated 3D subjects.",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser/verify-drawing.mjs",
    "test:runtime": "node test/browser/verify-runtime.mjs",
    "test:deployment": "node test/browser/verify-deployment.mjs",
    "test:eval": "node test/eval/run-generation.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0",
    "ses": "2.3.0",
    "three": "0.185.1"
  }
}
